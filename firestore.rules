rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── Player profiles ───────────────────────────────────────────────────────
    match /players/{uid} {
      allow read, write: if isOwner(uid);

      // Economy: server-write-only (Cloud Run with Admin SDK bypasses rules)
      match /economy/{doc} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Economy transaction log: server-write-only
      match /transactions/{txId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Daily reward state: server-write-only
      match /dailyRewards/{doc} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // IAP purchase records: server-write-only
      match /purchases/{purchaseId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Entitlement grants: server-write-only
      match /entitlements/{entitlementId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Progression: client readable+writable (conflict resolution in Cloud Run)
      match /progression/{doc} {
        allow read, write: if isOwner(uid);
      }

      // Mission progress: client readable+writable
      match /missions/{missionId} {
        allow read, write: if isOwner(uid);
      }

      // Achievement progress: client readable+writable
      match /achievements/{achievementId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── Catch-all: deny everything else ──────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
